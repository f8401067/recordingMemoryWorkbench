# ESP32-S3（推荐主控）：双核 240MHz、有 PSRAM、Opus 编码余量大
#
# 当前目标板：微雪 ESP32-S3-ePaper-1.54
#   V2 版本（2025/11 后出货，背面有 V2 丝印）：ESP32-S3-PICO-1-N8R8
#     → 8MB Flash + 8MB Octal PSRAM  ← 下面这份配置
#   V1 版本：ESP32-S3FH4R2，4MB Flash + 2MB PSRAM
#     → 改成 FLASHSIZE_4MB + partitions_4mb.csv，并去掉 SPIRAM_MODE_OCT
#       （FH4R2 里封的是 Quad PSRAM，按 Oct 初始化会起不来）
# 拿不准就先连上跑 python -m esptool --port <port> flash_id 看真实容量。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_8mb.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=160

# 主任务（app_main / app_run / do_upload 都跑在这里）栈够大：
# 默认 3584 字节，装不下 4KB 的 spool 数组，曾导致启动后随机崩
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768

# 板子的 Type-C 接的就是 ESP32-S3 自己的 USB，日志走 USB-Serial/JTAG。
# 留在 UART0 的话电脑上根本看不到日志（TX/RX 只在排针上）。
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 板级：微雪 ESP32-S3-ePaper-1.54（200x200 墨水屏 + ES8311，需 MCLK）
# 换板子就改这里：BOX0（240x240 ST7789）/ BOX3 / GENERIC
CONFIG_RECALL_BOARD_WS_EPAPER_154=y
CONFIG_RECALL_DISPLAY_EPAPER_154=y

# 常驻监听：有人声就录，静音 60 秒收尾上传
# 常驻模式下 1 秒人声就值得留（默认 3 秒会把短句丢掉）
CONFIG_RECALL_MIN_VOICED_MS=1500
CONFIG_RECALL_ALWAYS_ON=y
# 定时补传：有积压时每 4 小时自动开一次 WiFi 传上去并让服务端收尾（0=关闭）
CONFIG_RECALL_PERIODIC_UPLOAD_S=14400

# TF 卡（SDMMC 1-bit，原理图：CLK=GPIO39 / CMD=GPIO41 / D0=GPIO40，无 CS）
CONFIG_RECALL_SD_ENABLE=y
CONFIG_RECALL_SD_CLK=39
CONFIG_RECALL_SD_CMD=41
CONFIG_RECALL_SD_D0=40
CONFIG_RECALL_SILENCE_SPLIT_MS=30000
CONFIG_RECALL_QUIET_SCREEN=y
