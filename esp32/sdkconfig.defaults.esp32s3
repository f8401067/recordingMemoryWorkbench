# ESP32-S3（推荐主控）：双核 240MHz、有 PSRAM、Opus 编码余量大
# 实测板子：正点原子 DNESP32S3 BOX3（ESP32-S3-R8 + 8MB Octal PSRAM + 16MB Flash）
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=160

# 板级：正点原子 ATK-DNESP32S3 BOX0（1.54" 240x240 ST7789 + ES8311）
# 换板子就改这里：BOX3 / GENERIC
CONFIG_RECALL_BOARD_BOX0=y
CONFIG_RECALL_DISPLAY_ST7789=y
CONFIG_RECALL_LCD_PCLK_MHZ=40
CONFIG_RECALL_LCD_ROTATION=0
