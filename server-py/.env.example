PORT=8787
HOST=0.0.0.0
# 数据目录，默认 <项目根>/data。如需自定义请填绝对路径
# DATA_DIR=/absolute/path/to/data
# 生产环境请改成随机长字符串
JWT_SECRET=change-me-to-a-long-random-string
# 首次启动自动创建的账号
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
# 同时执行的转写任务数
ASR_CONCURRENCY=2
# 本地开源 ASR：同时推理的片段数。本地模型吃 CPU/内存，默认 1（串行）
# LOCAL_ASR_CONCURRENCY=1
# 本地模型下载源。默认走 hf-mirror.com（国内可直连）；
# 有外网直连就设 HF_DOWNLOAD_SOURCE=hf，或用 HF_ENDPOINT 指向自建镜像
# HF_DOWNLOAD_SOURCE=mirror
# HF_ENDPOINT=https://hf-mirror.com
# 本地 ASR（sherpa-onnx）模型包从 GitHub Releases 下载，国内慢时可换代理源；
# 默认直连失败后自动回退 https://gh-proxy.com，也可改为 https://ghproxy.net
# SHERPA_GH_PROXY=https://gh-proxy.com
# whisper.cpp 可执行文件路径，留空则从 PATH 里找 whisper-cli
# WHISPER_CPP_BIN=/opt/homebrew/bin/whisper-cli
LOG_LEVEL=info
# 数据库（只支持 PostgreSQL）。连接信息只写在配置文件里，界面不提供修改入口，改完重启生效。
# 可选查询参数：sslmode=disable|prefer|require|verify-full、schema=public、pool_size=10
# Docker 部署时这一行由 docker-compose.yml 注入（主机名是服务名 postgres），不用改这里。
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/recall?sslmode=disable
